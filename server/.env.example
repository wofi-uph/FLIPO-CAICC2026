# ------------- API Konfigurasi -------------
# API key (wajib). Jangan commit file .env yang berisi key asli.
DEEPSEEK_API_KEY=

# Host / endpoint API (opsional, default = DeepSeek official).
# Pastikan path lengkap ke endpoint chat/completions.
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# Model yang dipakai (opsional, default di bawah).
DEEPSEEK_MODEL=deepseek-v4-pro-0813

# ------------- Proxy -------------
# Port untuk backend proxy (opsional, default 3000).
PORT=3000